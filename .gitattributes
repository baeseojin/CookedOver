# Normalize source text; preserve binary assets byte-for-byte.
* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.cjs text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.asset text=auto
*.inputactions text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary

# Unity YAML writes a space after empty scalar values.
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.wlt text eol=lf whitespace=-blank-at-eol
