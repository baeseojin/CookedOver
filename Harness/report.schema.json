{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"CookedOver runtime harness report",
 "type":"object",
 "required":["schemaVersion","runId","role","chapter","status","checks"],
 "properties":{
  "schemaVersion":{"const":1},
  "runId":{"type":"string"},
  "role":{"enum":["host","client-1","client-2","client-3","overflow","rules"]},
  "chapter":{"enum":["Classic","Burgers","all"]},
  "status":{"enum":["running","passed","failed"]},
  "error":{"type":["string","null"]},
  "snapshots":{"type":"integer","minimum":0},
  "checks":{"type":"array","items":{"type":"object","required":["name","status"],"properties":{"name":{"type":"string"},"status":{"enum":["passed","failed"]},"detail":{"type":["string","null"]},"elapsedSeconds":{"type":"number","minimum":0}}}}
 }
}
